# 仅为本地开发示例；Go 启动入口读取进程环境，不自动加载 .env。
HTTP_PORT=18080

# Docker Compose 自动读取项目根目录的 .env（如果存在）。
LAB_MYSQL_PORT=13306
LAB_REDIS_PORT=16379
LAB_MYSQL_PASSWORD=lab_only_change_me
LAB_MYSQL_ROOT_PASSWORD=lab_root_only_change_me

# B1/B3 使用的连接提示，当前脚手架没有读取这些变量或连接依赖。
LAB_MYSQL_HOST=127.0.0.1
LAB_MYSQL_DATABASE=final_lab
LAB_MYSQL_USER=final_lab
LAB_REDIS_ADDR=127.0.0.1:16379
